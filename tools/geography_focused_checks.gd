extends SceneTree
## Compare seed geography against the pure .NET evidence generated by Geography.Checks.
## godot --headless --path . --script tools/geography_focused_checks.gd -- --evidence=/private/tmp/met-geography-focused.json
const Hex=preload("res://core/hex.gd")
var checks=0
var failures:Array[String]=[]
func check(ok:bool,label:String) -> void:
	checks+=1
	if not ok:failures.append(label)
func compare(actual,expected,path:String) -> void:
	if actual is Dictionary and expected is Dictionary:
		check(actual.size()==expected.size(),path+" key count")
		for key in expected:
			check(actual.has(key),path+" has "+str(key))
			if actual.has(key):compare(actual[key],expected[key],path+"."+str(key))
	elif actual is Array and expected is Array:
		check(actual.size()==expected.size(),path+" array count")
		for index in mini(actual.size(),expected.size()):compare(actual[index],expected[index],path+"[%d]"%index)
	elif (actual is int or actual is float) and (expected is int or expected is float):check(absf(float(actual)-float(expected))<1e-12,path+" numeric parity")
	else:check(actual==expected,path+" value parity")
func _initialize() -> void:
	var evidence_path="/private/tmp/met-geography-focused.json"
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--evidence="):evidence_path=arg.trim_prefix("--evidence=")
	if not FileAccess.file_exists(evidence_path):
		push_error("Missing pure .NET geography evidence: "+evidence_path);quit(1);return
	var evidence=JSON.parse_string(FileAccess.get_file_as_string(evidence_path))
	if not evidence is Dictionary or not evidence.has("parity_examples"):
		push_error("Invalid geography evidence");quit(1);return
	for row in evidence.parity_examples:
		var cells=Hex.make_map(int(row.landing),int(row.seed))
		compare(cells,row.cells,"cells seed %d landing %d"%[row.seed,row.landing])
		compare(Hex.geography(cells,int(row.seed),int(row.landing)),row.geography,"geography seed %d landing %d"%[row.seed,row.landing])
	print(JSON.stringify({"scope":"Godot/C# same-seed geography parity","checks":checks,"examples":evidence.parity_examples.size(),"failures":failures}))
	quit(0 if failures.is_empty() else 1)
