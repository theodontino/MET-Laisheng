{
  "industrial": {
    "name": "工会总部",
    "rules": [
      {
        "id": "goods",
        "op": "modify",
        "targets": "self",
        "field": "output.goods",
        "mode": "multiply",
        "value": 1.12,
        "when": {
          "any_traits": [
            "building.industrial"
          ]
        }
      },
      {
        "id": "personnel",
        "op": "modify",
        "targets": "self",
        "field": "personnel_mult",
        "mode": "multiply",
        "value": 1.08,
        "when": {
          "any_traits": [
            "building.industrial"
          ]
        }
      }
    ],
    "id": "capstone:industrial",
    "theme": "industrial",
    "function_role": "industrial",
    "description": "本Block定型建筑；效果可在规则来源中查询。"
  },
  "civic": {
