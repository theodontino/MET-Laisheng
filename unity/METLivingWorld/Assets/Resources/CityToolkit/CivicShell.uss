.civic-stage { position:absolute; left:0;right:0;top:0;bottom:0;color:rgb(227,237,236);font-size:22px; }
.c-surface { background-color:rgb(13,27,34);border-width:1px;border-color:rgb(55,81,92);border-radius:5px;overflow:hidden; }
Label { margin:0;padding:0; }
.c-text { white-space:normal;flex-shrink:0; }
.c-row > .c-text {flex-shrink:1;}
.c-muted { color:rgb(187,207,214); }
.c-good { color:rgb(123,219,194); }
.c-warning { color:rgb(237,186,119); }
.c-danger { color:rgb(239,139,125); }
.c-small {font-size:18px;}
.c-micro {font-size:16px;}
.c-heading {font-size:24px;-unity-font-style:bold;}
.c-number {font-size:30px;-unity-font-style:bold;}
.c-hero {font-size:34px;-unity-font-style:bold;}
.c-align-right {margin-left:auto;-unity-text-align:middle-right;}
.c-row {flex-direction:row;align-items:center;flex-shrink:0;}
.c-row > * {margin-right:12px;}
.c-column {flex-direction:column;min-width:0;flex-shrink:0;}
.c-row > .c-column {flex-grow:1;flex-basis:0;}
.c-grow {flex-grow:1;flex-basis:0;min-width:0;}
.c-wrap {flex-wrap:wrap;}
.c-half {width:48%;flex-grow:1;flex-basis:46%;}
.c-third {width:31%;flex-grow:1;flex-basis:30%;}
.c-section {padding:12px 0 18px 0;margin-bottom:10px;border-bottom-width:1px;border-bottom-color:rgb(39,62,72);}
.c-section-head {margin-bottom:16px;justify-content:space-between;flex-wrap:wrap;}
.c-section-head > .c-heading {margin-right:16px;}
.c-button {min-height:44px;margin:0;padding:9px 14px;border-width:1px;border-color:rgb(59,87,98);border-radius:4px;background-color:rgb(26,45,55);color:rgb(225,237,237);white-space:normal;flex-shrink:0;}
.c-button:hover {background-color:rgb(37,65,72);border-color:rgb(104,166,165);}
.c-button:focus {border-color:rgb(204,239,215);}
.c-button:disabled {color:rgb(125,145,151);background-color:rgb(27,39,45);border-color:rgb(45,62,70);}
.c-button.is-primary,.c-button.is-selected {background-color:rgb(28,85,80);border-color:rgb(99,192,170);color:rgb(192,255,232);}
.c-button.is-primary:hover,.c-button.is-selected:hover {background-color:rgb(38,109,97);}
.c-button.c-quiet {background-color:rgba(0,0,0,0);border-color:rgba(0,0,0,0);}
.c-button.c-icon-button {min-width:42px;min-height:42px;padding:6px 12px;}
.c-choice {flex-grow:0;flex-basis:auto;align-items:stretch;min-height:98px;padding:18px;margin-bottom:10px;-unity-text-align:upper-left;}
.c-choice .c-heading {margin-bottom:8px;}
.c-choice.is-selected {border-top-width:3px;padding-top:16px;}
.c-value {padding:12px 14px;background-color:rgb(20,38,47);border-radius:4px;}
.c-value > .c-number {margin:5px 0;}
.c-meter {padding:10px 0;flex-shrink:0;}
.c-meter-head {margin-bottom:9px;align-items:flex-end;}
.c-metric {color:rgb(221,242,235);font-size:21px;}
.c-track {height:10px;min-height:10px;background-color:rgb(38,59,70);border-radius:3px;overflow:hidden;margin-bottom:7px;}
.c-fill {height:100%;background-color:rgb(102,197,175);}
.c-warning .c-fill {background-color:rgb(229,180,101);}
.c-danger .c-fill {background-color:rgb(219,127,109);}
.c-pair {padding:8px 0;border-bottom-width:1px;border-bottom-color:rgba(53,79,88,0.5);align-items:flex-start;}
.c-empty {padding:22px 6px;}
.c-empty .c-heading {margin-bottom:10px;}
.c-fold {padding:9px 0;border-top-width:1px;border-top-color:rgb(40,64,74);margin-top:8px;color:rgb(165,194,201);}
.c-fold > .unity-foldout__toggle {min-height:38px;margin:0;white-space:normal;}
.c-fold > .unity-foldout__content {margin-left:10px;padding-top:10px;}
.c-field {margin:8px 0;min-height:46px;flex-shrink:0;}
.c-field {flex-direction:column;align-items:stretch;}
.c-row > .c-field {flex-grow:1;flex-basis:42%;min-width:240px;}
.c-field > .unity-base-field__label {max-width:none;margin-bottom:6px;}
.c-field > .unity-base-field__label {min-width:100px;max-width:42%;white-space:normal;color:rgb(165,190,197);}
.c-field .unity-base-field__input {background-color:rgb(5,18,26);border-width:1px;border-color:rgb(64,98,110);color:rgb(231,241,238);padding:8px 12px;white-space:normal;}
.c-field .unity-base-field__input {min-height:44px;flex-shrink:0;}
.c-stages {align-items:flex-start;margin-top:14px;}
.c-stages > .c-column {padding:16px;background-color:rgb(18,35,44);border-top-width:2px;border-top-color:rgb(54,82,94);}
.c-stages > .is-selected {border-top-color:rgb(102,197,175);}
.c-stages .c-section-head {flex-direction:column;align-items:flex-start;}
.c-stages .c-section-head .c-align-right {margin-left:0;margin-top:8px;}
.c-stages > .c-text {margin-top:30px;}
.c-third .c-meter-head {flex-direction:column;align-items:stretch;}
.c-third .c-meter-head .c-align-right {margin-left:0;-unity-text-align:upper-left;}
.c-toggle {margin:8px 0;min-height:36px;white-space:normal;}
.c-toggle .unity-toggle__label {white-space:normal;flex-shrink:1;}
.c-table {margin:10px 0;}
.c-table-row {align-items:flex-start;padding:10px 8px;border-bottom-width:1px;border-bottom-color:rgb(40,63,74);}
.c-table-head {background-color:rgb(22,43,53);color:rgb(153,183,194);}
.c-table-cell {flex-grow:1;flex-basis:0;min-width:0;white-space:normal;}
.c-icon {width:28px;height:28px;min-width:28px;min-height:28px;flex-shrink:0;-unity-background-scale-mode:scale-to-fit;-unity-background-image-tint-color:rgb(124,204,194);}
.c-top {position:absolute;left:0;right:0;top:0;min-height:84px;flex-direction:row;align-items:center;border-radius:0;padding:8px 14px;}
.c-brand {font-size:26px;-unity-font-style:bold;min-width:96px;border-width:0;background-color:rgba(0,0,0,0);}
.c-resource {flex-grow:1;flex-basis:0;min-width:0;flex-direction:row;align-items:center;padding:4px 14px;border-width:0;border-right-width:1px;border-right-color:rgb(44,70,77);border-radius:0;background-color:rgba(0,0,0,0);}
.c-resource .c-icon {margin-right:12px;}
.c-resource .c-number {font-size:27px;}
.c-top-capacity {width:340px;min-width:300px;padding-left:20px;}
.c-top-capacity .c-meter {padding:1px 0;}
.c-top-capacity .c-track {height:6px;min-height:6px;margin-bottom:2px;}
.c-top-capacity .c-meter-head {margin-bottom:3px;}
.c-nav {position:absolute;left:16px;top:102px;width:194px;padding:8px;}
.c-nav .c-button {border-width:0;flex-direction:row;align-items:center;-unity-text-align:middle-left;margin-bottom:4px;padding:10px 8px;}
.c-nav .c-icon {width:24px;height:24px;min-width:24px;min-height:24px;margin-right:10px;}
.c-nav .c-text {flex-grow:1;}
.c-nav-group {margin:14px 8px 7px 8px;color:rgb(111,146,155);font-size:16px;}
.c-workspace {position:absolute;left:226px;top:102px;width:820px;bottom:118px;border-top-color:rgb(90,176,163);border-top-width:2px;}
.c-workspace.is-wide {right:16px;width:auto;}
.c-panel-head {padding:18px 24px;background-color:rgb(19,38,47);border-bottom-width:1px;border-bottom-color:rgb(56,85,96);flex-shrink:0;}
.c-panel-head .c-small {margin-bottom:7px;}
.c-tabs {flex-direction:row;padding:8px 20px;background-color:rgb(16,31,40);flex-shrink:0;}
.c-tabs .c-button {flex-grow:1;flex-basis:0;margin-right:6px;}
.c-body {padding:12px 24px 22px 24px;}
.c-actions {flex-direction:row;align-items:center;flex-wrap:wrap;padding:14px 22px;background-color:rgb(19,38,47);border-top-width:1px;border-top-color:rgb(56,85,96);flex-shrink:0;}
.c-actions .c-button {flex-grow:1;flex-basis:0;margin:4px 6px;min-height:48px;}
.c-actions > .c-text {flex-grow:1;margin:4px 8px;}
.c-scroll {flex-grow:1;flex-shrink:1;min-height:0;}
.c-scroll .unity-scroll-view__content-viewport {overflow:hidden;min-width:0;}
.c-scroll .unity-scroll-view__content-container {width:100%;}
.c-scroll .unity-scroll-view__horizontal-scroller {display:none;}
.c-scroll .unity-scroll-view__vertical-scroller {width:12px;min-width:12px;margin:8px 4px 8px 0;}
.c-scroll .unity-scroller__low-button,.c-scroll .unity-scroller__high-button {display:none;}
.c-scroll .unity-base-slider__tracker {background-color:rgb(25,44,53);border-width:0;border-radius:4px;}
.c-scroll .unity-base-slider__dragger {background-color:rgb(68,118,121);border-color:rgb(86,149,146);border-radius:4px;min-width:8px;}
.c-scroll .unity-base-slider__dragger-border {border-width:0;background-color:rgba(0,0,0,0);}
.c-tile {position:absolute;left:16px;bottom:16px;width:740px;height:620px;border-top-color:rgb(90,176,163);border-top-width:2px;}
.c-tile .c-panel-head {padding:12px 18px;}
.c-tile .c-body {padding:10px 18px;}
.c-tile .c-section {padding:7px 0 10px 0;margin-bottom:4px;}
.c-tile .c-section-head {margin-bottom:7px;}
.c-tile .c-heading {font-size:21px;}
.c-tile .c-small {font-size:17px;}
.c-tile .c-actions {padding:8px 12px;}
.c-tile .c-meter {padding:4px 0;}
.c-tile .c-meter-head {margin-bottom:5px;}
.c-tile .c-track {height:7px;min-height:7px;}
.c-portrait {width:154px;height:112px;min-width:154px;flex-shrink:0;border-width:1px;border-color:rgb(67,111,120);border-radius:4px;-unity-background-scale-mode:scale-and-crop;}
.c-tile-identity {align-items:flex-start;margin-bottom:12px;}
.c-tile-identity .c-value {background-color:rgba(0,0,0,0);padding:0;}
.c-tile-net {width:39%;padding-right:14px;}
.c-tile-services {width:61%;padding-left:14px;border-left-width:1px;border-left-color:rgb(44,70,81);}
.c-slot {min-height:70px;flex-basis:0;flex-grow:1;margin:4px;padding:8px;}
.c-guide {position:absolute;right:16px;top:102px;width:350px;padding:14px 18px;}
.c-guide .c-button {margin-top:8px;}
.c-notices {position:absolute;right:16px;bottom:108px;width:350px;padding:10px;}
.c-notices .c-button {margin:3px 0;}
.c-layers {position:absolute;left:780px;right:440px;bottom:16px;padding:8px 10px;}
.c-layer-row {flex-direction:row;flex-wrap:wrap;justify-content:center;}
.c-layer-row .c-button {min-width:73px;flex-basis:9.8%;flex-grow:1;flex-direction:row;align-items:center;padding:7px 5px;border-width:0;}
.c-layer-row .c-icon {width:21px;height:21px;min-width:21px;min-height:21px;margin-right:5px;}
.c-layer-source {margin-bottom:7px;-unity-text-align:middle-center;color:rgb(151,181,188);}
.c-clock {position:absolute;right:16px;bottom:16px;width:402px;min-height:76px;padding:12px;flex-direction:row;align-items:center;}
.c-clock .c-button {margin-left:5px;padding:7px 10px;}
.c-clock .c-column {flex-grow:1;}
.c-map-return {position:absolute;left:226px;top:102px;}
.c-toast {position:absolute;bottom:132px;left:36%;right:24%;padding:12px 20px;border-left-width:3px;border-left-color:rgb(102,197,175);}
.c-shade {position:absolute;left:216px;right:0;top:94px;bottom:96px;background-color:rgba(2,10,16,.55);}
.c-drawer {position:absolute;right:16px;top:102px;bottom:118px;width:640px;border-top-width:2px;border-top-color:rgb(90,176,163);}
.c-operation-shade {position:absolute;left:0;right:0;top:0;bottom:0;align-items:center;justify-content:center;background-color:rgba(3,9,13,.82);}
.c-operation {width:1680px;max-width:94%;height:1120px;max-height:94%;border-top-width:3px;border-top-color:rgb(99,202,182);border-radius:8px;}
.c-operation.is-confirm {width:860px;height:auto;max-height:82%;}
.c-operation.is-confirm .c-scroll {min-height:110px;max-height:600px;}
.c-operation .c-body {padding:18px 30px 24px 30px;}
.c-operation .c-panel-head {padding:22px 30px;}
.c-operation .c-actions {padding:18px 26px;}
.c-operation .c-actions .c-button {flex-grow:0;flex-basis:auto;min-width:175px;min-height:58px;}
.c-decision-main {width:67%;padding-right:24px;}
.c-decision-limits {width:33%;padding-left:24px;border-left-width:1px;border-left-color:rgb(51,77,89);}
.c-high-contrast .c-surface {background-color:rgb(5,16,24);border-color:rgb(122,190,186);}
.c-high-contrast .c-muted {color:rgb(194,215,221);}
.c-high-contrast .c-track {background-color:rgb(54,84,97);}

.c-layers-two-rows .c-layer-row .c-button {flex-basis:19%;}
.c-row > .c-tile-net {flex-basis:39%;flex-grow:0;}
.c-row > .c-tile-services {flex-basis:57%;flex-grow:1;}
.c-row > .c-decision-main {flex-basis:65%;flex-grow:1;}
.c-row > .c-decision-limits {flex-basis:31%;flex-grow:1;}
.c-tile-build {flex-direction:row;align-items:center;justify-content:center;}
.c-tile-build .c-icon {margin-right:12px;}

.c-clock {flex-wrap:wrap;}
.c-clock > .c-column {flex-basis:100%;flex-direction:row;justify-content:space-between;margin-bottom:6px;}
.c-clock > .c-button {flex-grow:1;}
.c-nav .c-button {min-height:44px;}
.c-top-capacity {width:380px;min-width:350px;}

.c-pair > .c-text {flex-grow:1;flex-basis:0;}
.c-tooltip {position:absolute;max-width:520px;padding:18px 22px;background-color:rgb(7,21,30);color:rgb(239,247,247);border-width:1px;border-color:rgb(130,185,186);border-radius:4px;}
.c-tooltip Label {color:rgb(239,247,247);white-space:normal;-unity-text-align:upper-left;flex-shrink:0;}
.c-fold .unity-toggle__text,.c-fold .unity-foldout__text,.c-fold .unity-foldout__toggle:checked .unity-toggle__text,.c-fold .unity-foldout__toggle:focus .unity-toggle__text,.c-fold .unity-foldout__toggle:hover .unity-toggle__text {color:rgb(211,233,235);}
.c-fold .unity-foldout__checkmark {-unity-background-image-tint-color:rgb(173,219,215);}

.c-text {-unity-text-align:upper-left;}
.c-align-right {-unity-text-align:middle-right;}
.c-row > .c-column.c-half {flex-basis:46%;}
.c-row > .c-column.c-third {flex-basis:30%;}
.c-row > .c-choice {flex-grow:1;flex-basis:0;}
.c-meter-head {flex-shrink:0;}
.c-top-capacity .c-meter-head .c-text {font-size:16px;}
.c-tile .c-panel-head .c-heading {font-size:26px;}

/* Management is a separate reading surface with fixed headings and independent lists. */
.c-management {display:none;flex-grow:1;flex-shrink:1;min-height:0;padding:18px 24px;overflow:hidden;}
.c-management-layout {flex-grow:1;flex-shrink:1;min-height:0;align-items:stretch;overflow:hidden;}
.c-management-list {flex-grow:1;flex-shrink:1;min-height:0;min-width:0;background-color:rgb(14,30,39);border-width:1px;border-color:rgb(50,75,87);padding:12px;}
.c-management-inspector {flex-grow:0;flex-shrink:1;flex-basis:auto;min-height:0;min-width:0;background-color:rgb(19,39,48);border-width:1px;border-color:rgb(73,105,113);padding:18px;}
.c-row > .c-management-inspector {flex-basis:auto;flex-grow:0;}
.c-management-scroll {flex-grow:1;flex-shrink:1;min-height:0;min-width:0;}
.c-management-scroll .unity-scroll-view__content-container {padding-right:10px;}
.c-management-scroll .unity-scroll-view__vertical-scroller {width:14px;min-width:14px;}
.c-management-scroll .unity-scroller__low-button,.c-management-scroll .unity-scroller__high-button {display:none;}
.c-management-scroll .unity-base-slider__tracker {background-color:rgb(29,48,58);border-width:0;}
.c-management-scroll .unity-base-slider__dragger {background-color:rgb(103,160,162);border-width:0;}
.c-management-toolbar {flex-wrap:wrap;align-items:center;margin-bottom:14px;flex-shrink:0;}
.c-management-toolbar > .c-value {flex-grow:1;flex-basis:0;min-width:180px;}
.c-management-toolbar .c-field {min-width:220px;flex-basis:24%;margin-right:16px;}
.c-management-header {flex-shrink:0;align-items:flex-start;padding:12px 14px;background-color:rgb(27,49,61);border-bottom-width:1px;border-bottom-color:rgb(81,118,132);color:rgb(218,235,239);}
.c-management-row {align-items:flex-start;padding:13px 14px;border-width:0;border-bottom-width:1px;border-bottom-color:rgb(42,66,79);border-radius:0;background-color:rgb(15,32,42);flex-shrink:0;white-space:normal;}
.c-management-row:hover {background-color:rgb(29,57,68);}
.c-management-row.is-selected {background-color:rgb(29,72,76);border-left-width:3px;border-left-color:rgb(112,222,194);padding-left:11px;}
.c-management-row:focus {border-bottom-color:rgb(165,226,220);}
.c-management-cell {flex-grow:1;flex-basis:0;min-width:0;white-space:normal;margin-right:18px;-unity-text-align:upper-left;}
.c-management .c-management-cell {color:rgb(231,241,243);}
.c-management .c-management-header .c-management-cell {color:rgb(190,216,226);}
.c-management-modules {flex-direction:row;flex-wrap:wrap;margin-top:14px;}
.c-management-modules .c-button {margin-right:8px;min-height:40px;}
.c-workspace.is-wide {left:16px;right:16px;top:16px;bottom:16px;width:auto;}
.c-workspace.is-wide .c-panel-head {padding:14px 24px;}
.c-shade {left:0;right:0;top:0;bottom:0;background-color:rgb(5,15,22);}
.c-field > .unity-base-field__label {max-width:none;color:rgb(198,220,226);}
.c-field .unity-base-popup-field__text {color:rgb(239,247,247);}
.unity-base-dropdown__container-outer {background-color:rgb(10,27,37);border-color:rgb(113,169,177);}
.unity-base-dropdown__item {color:rgb(235,245,246);background-color:rgb(16,35,45);}
.unity-base-dropdown__item:hover {background-color:rgb(35,80,83);color:rgb(255,255,255);}
