extends "res://tests/ui_impacts.gd"
func run() -> void:
	started_at=Time.get_unix_time_from_system();app=App.new();app.test_mode=true;app.ignore_save=true;root.add_child(app);app.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT);await frames(10)
	app.test_mode=true;app.ignore_save=true;app.feedback_layer.set_process(false)
	check(DisplayServer.get_name()!="headless","packaged test uses a native display")
	fullscreen("exported PCK startup")
	check(not DirAccess.dir_exists_absolute("res://unity") and not DirAccess.dir_exists_absolute("res://art_source") and not DirAccess.dir_exists_absolute("res://docs"),"runtime excludes editor/source/evidence directories")
	fixture();await frames();release_focus()
	var before=Store.encode(app.game.s)
	await click(app.header_nodes.menu,"packaged settings gear from idle city")
	check(app.overlay.visible and app.modal_title.text=="河谷手册与存档","packaged idle city opens manual")
	await capture("packed-settings-manual")
	await click(button_text(app.modal_body,"显示设置"),"packaged manual display settings")
	check(app.modal_title.text=="显示与交互","packaged idle manual reaches display settings")
	await key(KEY_ESCAPE,"packaged return to idle map")
	check(Store.encode(app.game.s)==before,"packaged idle settings preserve authoritative city")
	var tile=await start_site()
	await test_scale(tile)
	check(not app.overlay.visible and on_screen(app.header_nodes.menu),"packaged settings close returns to visible gear")
	fullscreen("exported PCK settings complete")
	finish()
