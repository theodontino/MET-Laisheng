        "audit.resources",
        "projects.inventory",
        "allocation_receipts"
      ],
      "encoding": "生产/消耗/库存/缺口",
      "query_resource": "food",
      "electricity_has_no_ordinary_stock": false,
      "show_no_fake_vehicle_routes": true
    },
