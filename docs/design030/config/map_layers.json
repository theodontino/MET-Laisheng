{
  "schema": "met030.layers_plan.v1",
  "status": "semantic_contract_not_drop_in_code",
  "max_primary_layers": 1,
  "source_fields_are_audit_paths_not_unverified_API_calls": true,
  "layers": [
    {
      "id": "terrain",
      "label_zh": "地形与规划",
      "data_source": [
        "cells.traits",
        "planning.terrain",
        "planning.compare"
      ],
      "encoding": "边界、功能符号、单格预测",
      "scale": "not_an_overall_recommendation_score"
    },
    {
      "id": "pollution",
      "label_zh": "环境",
      "data_source": [
        "cells.fields.pollution",
        "groups.living.pollution",
        "metrics.exposure_links"
      ],
      "encoding": "固定色带＋选中来源",
      "legend": {
        "unit": "环境负担指数",
        "display_breaks": [
          0,
          0.25,
          0.5,
          1,
          2
        ],
        "breaks_are_health_thresholds": false,
        "overflow": "arrow_and_exact_number"
      },
      "source_aware": true,
      "signed": true
    },
    {
      "id": "heat",
      "label_zh": "余热",
      "data_source": [
        "cells.fields.heat",
        "metrics.heat_receipts",
        "audit.heat_generated",
        "audit.heat_used"
      ],
      "encoding": "覆盖贡献与实际利用分开",
      "legend": {
        "unit": "本周期热量／对应场贡献",
        "display_breaks": [
          0,
          1,
          2,
          4
        ],
        "overflow": "arrow_and_exact_number"
      },
      "source_aware": true,
      "requires_existing_budget_audit_adapter": true
    },
    {
      "id": "service_medical",
      "label_zh": "医疗",
      "data_source": [
        "cells.fields.medical",
        "groups.living.medical",
        "metrics.service_links",
        "compiled.stats.service.medical"
      ],
      "encoding": "可达边界＋实际满足率＋不足斜纹",
      "query_kind": "medical",
      "denominator": "population_weighted_actual_need",
      "access_is_not_coverage": true,
      "source_preservation": [
        "source_id",
        "field_id",
        "via"
      ],
      "duplicate_paths_do_not_duplicate_capacity": true,
      "legend": {
        "display_breaks": [
          0,
          0.5,
          0.75,
          1
        ],
        "goal_marker_source": "active_city_goal_when_applicable",
        "empty_tile": "not_applicable",
        "no_data": "unknown_hatch"
      }
    },
    {
      "id": "service_education",
      "label_zh": "教育",
      "data_source": [
        "cells.fields.education",
